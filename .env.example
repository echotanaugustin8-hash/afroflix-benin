NODE_ENV=development
PORT=3000
# En production, utilisez une valeur aléatoire d'au moins 32 caractères.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
# URL(s) autorisées, séparées par des virgules. Exemple: https://afroflix.bj
CORS_ORIGIN=
TRUST_PROXY=0
MAX_UPLOAD_MB=500
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
CREATOR_RATE_PER_1000=100
CREATOR_REVENUE_SHARE=50
